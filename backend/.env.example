PORT=4000
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Model selection on DeepSeek's Anthropic-compatible endpoint is name-prefix based
# ("claude-opus-*" -> deepseek-v4-pro, "claude-haiku-*"/"claude-sonnet-*" -> deepseek-v4-flash;
# anything else, including the retired "deepseek-reasoner", silently falls back to
# deepseek-v4-flash). "Thinking" is a request-level param (see aiReviewService.js), not a
# model string — currently OFF there: enabling it exhausted max_tokens on reasoning alone
# and never produced the report JSON (budget_tokens is ignored by this endpoint).
DEEPSEEK_MODEL=deepseek-v4-flash

# --- LTI 1.3 (Moodle) ---
# Real values for these come from registering the tool in the Moodle admin panel.
# Fill in backend/.env once that registration is done.
LTI_PLATFORM_ISSUER=https://lms.abchorizon.com
LTI_PLATFORM_CLIENT_ID=REPLACE_ME
LTI_PLATFORM_DEPLOYMENT_ID=REPLACE_ME
LTI_PLATFORM_AUTH_LOGIN_URL=https://lms.abchorizon.com/mod/lti/auth.php
LTI_PLATFORM_AUTH_TOKEN_URL=https://lms.abchorizon.com/mod/lti/token.php
LTI_PLATFORM_KEYSET_URL=https://lms.abchorizon.com/mod/lti/certs.php
LTI_SESSION_SECRET=REPLACE_ME_WITH_A_RANDOM_LONG_STRING
# This server's own public base URL, e.g. an ngrok tunnel — update whenever the tunnel URL changes.
# The backend also serves the built frontend (frontend/dist), so this is both the
# LTI tool endpoint and the app's public URL — no separate frontend URL needed.
LTI_TOOL_BASE_URL=https://REPLACE-ME.ngrok-free.dev

# --- Moodle Web Services API ---
# Used to pull assignment info (title, instructions, due dates) and BTEC grading
# definitions (P1-D3 criteria) directly from Moodle instead of hardcoding them.
# Token permissions are managed at: Site administration → Server → Web services
MOODLE_BASE_URL=https://REPLACE-ME.example.com
MOODLE_WS_TOKEN_PROF=REPLACE_ME
MOODLE_WS_TOKEN_NEW=REPLACE_ME

# --- Sync admin ---
# Required header (X-Sync-Token) for the /api/sync/* endpoints, which pull course/assignment/
# student rosters from Moodle and expose per-student review data — keep this secret.
SYNC_ADMIN_TOKEN=REPLACE_ME_WITH_A_RANDOM_LONG_STRING